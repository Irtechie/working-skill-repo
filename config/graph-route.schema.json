{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Irtechie/working-skill-repo/config/graph-route.schema.json",
  "title": "KB Graph Route Impact Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "repository", "seeds", "edges", "fallback", "budget", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "root", "vcs", "revision", "worktree_fingerprint", "freshness"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "vcs": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "dirty_fingerprint": {"type": "string"},
        "worktree_fingerprint": {"type": "string", "minLength": 1},
        "freshness": {"enum": ["fresh", "dirty", "stale", "unknown"]},
        "freshness_explanation": {"type": "string"}
      }
    },
    "seeds": {"type": "object"},
    "edges": {"type": "array"},
    "direct_impact": {"type": "array"},
    "reverse_impact": {"type": "array"},
    "tests": {"type": "array", "items": {"type": "string"}},
    "docs": {"type": "array", "items": {"type": "string"}},
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_edges", "max_bytes", "truncated"],
      "properties": {
        "max_edges": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "truncated": {"type": "boolean"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "generated_by": {"type": "string"},
    "generated_at": {"type": "string"}
  }
}
